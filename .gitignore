# Generated build artifacts emitted next to packages/types sources during API builds
# (tsc emits .js/.d.ts/.map for the global types included via global.d.ts)
packages/types/src/**/*.js
packages/types/src/**/*.js.map
packages/types/src/**/*.d.ts.map
packages/types/src/**/*.d.ts
!packages/types/src/global.d.ts

# Seed/purge safety backups (drizzle) — timestamped JSON captures written by
# db:seed:backup / db:seed:revert / db:purge before any destructive run.
packages/api/drizzle/backups/
