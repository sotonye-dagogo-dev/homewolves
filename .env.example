# ── Homewolves environment reference ──────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.
# Missing optional vars degrade gracefully (see notes below).

# ── Shared / Database (Supabase + Drizzle) ─────────────────────────────────
# Postgres connection string used by Drizzle (postgres-js) in the NestJS API.
# For Supabase, use the connection string from Dashboard → Settings → Database
# → Connection string (direct or pooler). Example:
# postgresql://postgres.<project-ref>:<db-password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@db.<project-ref>.supabase.co:5432/postgres
# DB password (Supabase) — used to build DATABASE_URL and for tooling
DATABASE_PASSWORD=

# JWT signing secret for the NestJS API — MUST be set in production (fallback is dev-only)
JWT_SECRET=change-me

# ── Supabase (Auth) ─────────────────────────────────────────────────────────
# Public project URL + publishable key for the web client (Supabase Auth).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<publishable-key>
# Server-side secret key (Admin) — from Supabase Dashboard → Project Settings → API.
# Only used by the NestJS API; never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<secret-key>
# OAuth redirect URL for Supabase Auth. Must match one registered under
# Project Settings → Auth → URL Configuration (Redirect URLs).
NEXT_PUBLIC_SUPABASE_REDIRECT_URL=https://www.homewolves.com/auth/callback
# JWT secret from Supabase Dashboard → Project Settings → API → JWT Secret.
# Used server-side to verify Supabase Auth tokens in the NestJS API.
SUPABASE_JWT_SECRET=

# ── Web (Next.js) ───────────────────────────────────────────────────────────
# Public base URLs (Vercel sets these per environment)
# IMPORTANT: Use the canonical www host for both SITE and API. Vercel redirects
# the apex (homewolves.com) → www (www.homewolves.com) with a 308; fetches to
# the apex from a www page get blocked by CORS (no ACAO header on 308).
# Setting both to www keeps fetches same-origin via the Next.js rewrite proxy
# and avoids the redirect entirely. See apps/web/lib/api-base.ts and next.config.js rewrites.
NEXT_PUBLIC_SITE_URL=https://www.homewolves.com
NEXT_PUBLIC_API_URL=https://www.homewolves.com/api/v1
NEXT_PUBLIC_WS_URL=wss://www.homewolves.com
# Server-side proxy target for the /api/v1/* rewrite (Next.js → NestJS). When the
# API runs separately (external host), set API_PROXY_URL to its origin so the
# same-origin rewrite can forward. Otherwise leave unset for same-host deployments.
# Example: API_PROXY_URL=https://api.homewolves.com
API_PROXY_URL=

# ── API (NestJS) ────────────────────────────────────────────────────────────
PORT=4000
# Origin used for CORS + referral share links
WEB_URL=http://localhost:3000

# ── Resend (transactional email) ─────────────────────────────────────────────
# When RESEND_API_KEY is set, transactional emails (OTP, welcome, transaction
# lifecycle, listing moderation, price drops, …) are sent via Resend and each
# delivery is recorded in the EmailLog table. When unset the API simulates
# delivery — rendering content and logging status `simulated` (never fails).
RESEND_API_KEY=
# Optional sender override for Send.Best practices: a verified domain
# (e.g. system@homewolves.com) so your deliverability remains intact.
RESEND_FROM_EMAIL=hello@mail.homewolves.com
RESEND_FROM_NAME=Homewolves

# ── Paystack (subscriptions + featured listings) ────────────────────────────
# When PAYSTACK_SECRET_KEY is set, checkout/featured flows initialize real
# Paystack transactions and webhooks verify HMAC signatures. When unset the
# platform falls back to dev-mode links / auto-activation (fails gracefully).
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://www.homewolves.com/dashboard

# ── DocuSeal (e-signatures) ─────────────────────────────────────────────────
# When both are set, signature requests create real DocuSeal submissions and
# embed the signing URL. When unset, requests fall back to the in-app flow.
DOCUSEAL_API_URL=https://docuseal.com
DOCUSEAL_API_KEY=
# Webhook HMAC secret from DocuSeal → Webhooks → Security → HMAC tab (whsec_…).
# When set, the /signatures/webhook endpoint verifies the X-Docuseal-Signature
# header (HMAC-SHA256 over timestamp.body, 5-min replay window). When unset the
# signature is not enforced (dev mode) — matching the Paystack webhook behavior.
DOCUSEAL_WEBHOOK_SECRET=

# ── Optional infra ──────────────────────────────────────────────────────────
# When set and reachable, the rate limiter uses a shared Redis sliding-window
# store (safe for multi-instance deploys). When unset or unreachable it falls
# back to the in-memory per-instance limiter.
REDIS_URL=redis://localhost:6379

# Next.js build — ignore incorrect lockfile patch (Next 14.2.35 SWC quirk)
NEXT_IGNORE_INCORRECT_LOCKFILE=1
